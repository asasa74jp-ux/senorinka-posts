# ローカルで試すときの環境変数の見本です。本番の値は Render の画面で設定します。
# このファイルをコピーして .env にしても、GitHubには上げないでください。

LINE_CHANNEL_SECRET=ここにチャネルシークレット
LINE_CHANNEL_ACCESS_TOKEN=ここにチャネルアクセストークン（長期）

# Googleスプレッドシートの ID（URLの /d/ と /edit の間の文字列）
SPREADSHEET_ID=
# サービスアカウントの鍵（JSONファイルの中身をまるごと1行で）
GOOGLE_SERVICE_ACCOUNT_JSON=

# スプレッドシートを読み直す間隔（秒）。省略時は 300（5分）
CONTENT_CACHE_SECONDS=300
